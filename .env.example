# CoinMarketCap API (optionnel)
COINMARKETCAP_API_KEY=

# ================================
# STRIPE PAYMENT
# ================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ================================
# EMAIL CONFIGURATION
# ================================
