# ================================
# DATABASE
# ================================
DATABASE_URL=postgresql://crypto_user:crypto_password_dev@postgres:5432/crypto_platform

# ================================
# REDIS
# ================================
REDIS_HOST=redis
REDIS_PORT=6379

# ================================
# JWT AUTHENTICATION
# ================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
