{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/crypto-collector-platform/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/crypto-collector-platform/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/crypto-collector-platform",
  "projects": {
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.app.json"
      }
    },
    "collector": {
      "type": "application",
      "root": "apps/collector",
      "entryFile": "main",
      "sourceRoot": "apps/collector/src",
      "compilerOptions": {
        "tsConfigPath": "apps/collector/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "crypto-collector-platform": {
      "type": "application",
      "root": "apps/crypto-collector-platform",
      "entryFile": "main",
      "sourceRoot": "apps/crypto-collector-platform/src",
      "compilerOptions": {
        "tsConfigPath": "apps/crypto-collector-platform/tsconfig.app.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    }
  }
}